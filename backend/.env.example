# Copy to .env for local development. Contains NO secret values - only
# non-secret configuration. Actual credentials are always fetched from
# AWS Secrets Manager at runtime (requires local AWS CLI credentials with
# secretsmanager:GetSecretValue on the relevant secrets).

ENVIRONMENT=dev
AWS_REGION=us-east-1

S3_BUCKET_NAME=adc-prod-supplier-files
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/adc-prod-list-processing

SP_API_SECRET_NAME=adc/prod/sp-api-credentials
KEEPA_SECRET_NAME=adc/prod/keepa-api-key
DB_SECRET_NAME=<rds-managed-master-user-secret-arn>
# Shared key every caller (OpenClaw) must send as X-Api-Key - see
# modules/auth.py. Leave UNSET for local dev (auth is bypassed entirely
# when this is unset - never leave it unset in a real environment).
API_KEY_SECRET_NAME=adc/prod/api-key

DB_HOST=<rds-endpoint-from-terraform-output>
DB_PORT=5432
DB_NAME=adc
DB_USERNAME=adc_admin

# Local dev only: overrides everything above and skips Secrets Manager
# entirely, so schema/migration work doesn't need AWS credentials. Matches
# docker-compose.yml in this directory (`docker compose up -d`). Never set
# this in a real environment.
DATABASE_URL=postgresql+psycopg2://adc_admin:localdev_only_not_a_secret@localhost:5433/adc
